# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Everything prefixed VITE_ is inlined into the production bundle at build time.
# Only ever put PUBLIC values here.

# Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable key — Dashboard > Settings > API. Looks like sb_publishable_...
# Safe in the browser: RLS and the admin Edge Functions enforce access.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# DEPRECATED legacy anon JWT. Still read as a fallback so existing setups keep
# working; prefer VITE_SUPABASE_PUBLISHABLE_KEY above.
# VITE_SUPABASE_ANON_KEY=

# DO NOT ADD, EVER:
#   service_role key / sb_secret_... / personal access token (sbp_...)
#   LICENSE_PRIVATE_KEY_PEM
#   LICENSE_KEY_HASH_SECRET
#   RESEND_API_KEY
