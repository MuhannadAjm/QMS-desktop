# ============================================================
# QMS Desktop — .gitignore
# ============================================================

# ------ Node / npm ------
node_modules/
license-admin/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------ Build outputs ------
dist/
dist-ssr/
.cargo/

# ------ Rust / Cargo ------
target/
src-tauri/target/

# ------ Tauri ------
src-tauri/gen/

# ------ Test / release build artifacts (use GitHub Releases instead) ------
test-builds/
*.msi
*.exe

# ------ Environment files — NEVER commit secrets ------
.env
.env.*
*.env
*.local
!.env.example
!.env.*.example

# ------ Private keys and secrets — NEVER commit ------
*.pem
*.key
*.p12
*.pfx
license_private_key.pem
license_public_key.pem
license_hash_secret.txt

# ------ Supabase CLI state ------
supabase/.temp/

# ------ Local database files (customer data — not committed) ------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ------ Upload / backup data directories ------
uploads/
backups/

# ------ TypeScript incremental build ------
*.tsbuildinfo

# ------ OS / editor artifacts ------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# ------ JetBrains / VS Code ------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------ Logs ------
*.log
