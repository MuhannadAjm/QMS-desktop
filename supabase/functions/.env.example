# Supabase Edge Function Environment Variables
# Set these via: supabase secrets set KEY=value
# Or via the Supabase Dashboard → Settings → Edge Functions

# ── Required ───────────────────────────────────────────────────────────────────

# Your Supabase project URL (not a secret, also in the client)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Service role key — server-side only, never expose to the browser
# Found in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# RSA-2048 private key for signing license tokens (PKCS#8 PEM format).
# The matching PUBLIC KEY is embedded in the desktop Rust binary.
# NEVER share this key. NEVER commit the real key to source control.
# Store multiline PEM as escaped newlines when using CLI.
# DO NOT generate a new pair here. The production pair already exists
# (license_private_key.pem / license_public_key.pem, public half embedded in
# src-tauri/src/license/rsa_public_key.rs). Rotation is a breaking change that
# needs owner sign-off and a coordinated rebuild — see README_LICENSE_SERVER.md step 8.
LICENSE_PRIVATE_KEY_PEM=REPLACE_WITH_ESCAPED_PKCS8_PRIVATE_KEY

# Secret used to pepper the license key hash (prevents rainbow table attacks).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_KEY_HASH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX_STRING

# Issuer identifier embedded in logs/events (not in the token itself)
LICENSE_TOKEN_ISSUER=license-server

# ── Admin Portal ───────────────────────────────────────────────────────────────
# These are for the license-admin/ web app (set in license-admin/.env)

# VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
